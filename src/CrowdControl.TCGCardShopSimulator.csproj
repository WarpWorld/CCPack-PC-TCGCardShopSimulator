<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <!-- ALWAYS SET THESE FOR A NEW GAME! -->
    <GameName>TCGCardShopSimulator</GameName>
    <TargetFramework>netstandard2.1</TargetFramework>
    <GameBaseDir>D:\SteamLibrary\steamapps\common\TCG Card Shop Simulator</GameBaseDir>
    <GameAssemblyDir>$(GameBaseDir)\Card Shop Simulator_Data\Managed</GameAssemblyDir>
    <!--========================================-->

    <RootNamespace>CrowdControl</RootNamespace>
    <!-- Kept as "CrowdControl" (rather than CrowdControl.$(GameName)) so the new build drops in over the
         file existing installs already have in BepInEx\plugins\CrowdControl. -->
    <AssemblyName>CrowdControl</AssemblyName>
    <Product>Crowd Control for $(GameName)</Product>

    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Custom (community) effects are not enabled for this game (CUSTOM_EFFECTS_SUPPORTED is false),
         so leave the ~14MB Roslyn compiler out of the plugin folder. -->
    <IncludeCustomEffectCompiler Condition="'$(IncludeCustomEffectCompiler)' == ''">false</IncludeCustomEffectCompiler>
  </PropertyGroup>

  <PropertyGroup>
    <Build>$([System.DateTime]::op_Subtraction($([System.DateTime]::get_Now().get_Date()),$([System.DateTime]::new(2000,1,1))).get_TotalDays())</Build>
    <Revision>$([MSBuild]::Divide($([System.DateTime]::get_Now().get_TimeOfDay().get_TotalSeconds()), 2).ToString('F0'))</Revision>
    <Version Condition="'$(DesignTimeBuild)' != 'true' OR '$(BuildingProject)' == 'true'">5.0.$(Build).$(Revision)</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The game ships Newtonsoft.Json 13.0.x in its Managed folder, so the package is compile-only here. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0">
      <ExcludeAssets Condition="'$(IncludeCustomEffectCompiler)' == 'false'">runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The old OBJ loader sample was never part of the build. -->
    <Compile Remove="Plugins\**" />
    <Compile Remove="bin\**;obj\**;packages\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(GameBaseDir)\BepInEx\core\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(GameBaseDir)\BepInEx\core\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameAssemblyDir)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(GameAssemblyDir)\Assembly-CSharp-firstpass.dll</HintPath>
    </Reference>
    <Reference Include="Heathen.Steamworks">
      <HintPath>$(GameAssemblyDir)\Heathen.Steamworks.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameAssemblyDir)\Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameAssemblyDir)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(GameAssemblyDir)\UnityEngine.AIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(GameAssemblyDir)\UnityEngine.AnimationModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(GameAssemblyDir)\UnityEngine.AssetBundleModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameAssemblyDir)\UnityEngine.AudioModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameAssemblyDir)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameAssemblyDir)\UnityEngine.IMGUIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameAssemblyDir)\UnityEngine.ImageConversionModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameAssemblyDir)\UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameAssemblyDir)\UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameAssemblyDir)\UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameAssemblyDir)\UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameAssemblyDir)\UnityEngine.UIModule.dll</HintPath>
    </Reference>
    <!-- Hype train prefab behaviour, shipped with the mod (resources\HypeTrain.dll is copied to the plugin folder). -->
    <Reference Include="HypeTrain">
      <HintPath>resources\HypeTrain.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConnectorLib.JSON\ConnectorLib.JSON.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <Company>Warp World, Inc.</Company>
    <Copyright>© 2025 Warp World, Inc.</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <!-- Copies the built plugin into the game's BepInEx\plugins\CrowdControl folder and into the repo's
       mod\ folder (the shipped layout) after every build. -->
  <PropertyGroup>
    <PluginsDir>$(GameBaseDir)\BepInEx\plugins\CrowdControl</PluginsDir>
    <RepoModDir>$(MSBuildProjectDirectory)\..\mod\BepInEx\plugins\CrowdControl</RepoModDir>
  </PropertyGroup>
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true'">
    <ItemGroup>
      <DeployFiles Include="$(TargetPath)" />
      <DeployFiles Include="$(TargetDir)ConnectorLib.JSON.dll" />
      <DeployFiles Include="$(MSBuildProjectDirectory)\resources\HypeTrain.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(PluginsDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(RepoModDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Message Importance="high" Text="Deployed to $(PluginsDir) and $(RepoModDir)" />
  </Target>

</Project>
